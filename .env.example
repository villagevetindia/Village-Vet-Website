# VillageVet AI — local development
# Get a Gemini API key from Google AI Studio, then copy this file to .env.
# Never commit or publish your real API key.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Stable model used by the included backend.
GEMINI_MODEL=gemini-3.6-flash

# Local AI server port. Vite proxies /api requests here.
AI_PORT=8787

# MongoDB connection for enquiries and chat storage
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=VillageVetWebsite
MONGODB_DB=villagevet

# Optional for production if you want to restrict browser origins.
# AI_CORS_ORIGIN=https://www.villagevetindia.com
