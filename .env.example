# =============================================================================
# VillageVet India — Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# WARNING: NEVER commit .env or paste real secrets into version control.
# =============================================================================

# Server-side Gemini AI credentials (DO NOT prefix with VITE_)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend server port (Node / Express API server)
PORT=8787
AI_PORT=8787

# Server-side MongoDB connection (DO NOT prefix with VITE_)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/?appName=VillageVetWebsite
MONGODB_DB=villagevet

# Production CORS restriction (optional)
# AI_CORS_ORIGIN=https://www.villagevetindia.com

# =============================================================================
# Client-side Public Variables (Vite bundles these into public browser assets)
# ONLY public-safe values belong here. NEVER put private keys or secrets here.
# =============================================================================
# VITE_CONTACT_FORM_ENDPOINT=/api/contact
# VITE_AI_STREAM_ENDPOINT=/api/chat/stream
# VITE_WHATSAPP_NUMBER=+919704420273
# VITE_SOCIAL_INSTAGRAM=https://instagram.com/villagevetindia
# VITE_SOCIAL_FACEBOOK=https://facebook.com/villagevetindia
# VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/villagevetindia
# VITE_SOCIAL_YOUTUBE=https://youtube.com/@villagevetindia
